          "raw": "{{baseUrl}}/api/dates/feed",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dates",
            "feed"
          ]
        }
      }
    },
    {
      "name": "06 GET лента по id next true",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dates/feed?id=2&next=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dates",
            "feed"
          ],
          "query": [
            {
              "key": "id",
              "value": "2"
            },
            {
              "key": "next",
              "value": "true"
            }
          ]
